# Environment configuration for the AI news platform.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
# Shared secret for admin/ops endpoints (source health, manual triggers). Required in production.
ADMIN_API_TOKEN=change-me

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Application connects with a least-privilege role, not the superuser.
DATABASE_URL=postgresql+asyncpg://news_app:change-me@postgres:5432/news

# --- Queue (Redis + Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Frontend ---
# Server-side only; never exposed to the browser.
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:12000

# --- Ingestion ---
# Trust X-Forwarded-For only when running behind a proxy you control.
TRUST_PROXY_HEADERS=false
# Default feed window / polling.
DEFAULT_POLL_INTERVAL_SECONDS=300
HTTP_USER_AGENT=NewsAI/0.1 (+https://example.com/bot)

# --- AI providers (Phase 4 editorial system) ---
# "openai" is the real writer and needs AI_API_KEY. "offline" is a
# deterministic, no-key writer for tests/dev only; it must not be published.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
# Images (Phase 6). Optional: with no provider, articles publish without an
# image. Generated images are NEVER stored on our infrastructure — only
# provider metadata and a transient URL reference are kept (spec section 20).
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_BASE_URL=
IMAGE_ENABLED=true
IMAGE_URL_TTL_SECONDS=3600

# --- Embeddings (Phase 3 clustering) ---
# "hashing" runs offline and deterministically (no API key needed).
# Set to "openai" to use a real embedding model.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
EMBEDDING_MAX_PER_PASS=200

# --- Clustering / event identity (Phase 3) ---
CLUSTER_SIMILARITY_THRESHOLD=0.70
CLUSTER_TYPE_MISMATCH_PENALTY=0.90
NEAR_DUPLICATE_THRESHOLD=0.92
EVENT_TIME_WINDOW_HOURS=72

# --- Verification / confidence (Phase 3) ---
MIN_CONFIDENCE_TO_PUBLISH=70
CONFIDENCE_INDEPENDENT_TARGET=5
CONFLICT_RELATIVE_TOLERANCE=0.05

# --- AI editorial system (Phase 4) ---
# Confirmed-but-trivial events below this importance are not published.
MIN_IMPORTANCE_TO_PUBLISH=30
# Max fraction of a draft's 8-grams allowed to match one source verbatim.
MAX_SOURCE_COPY_OVERLAP=0.30
# Run the AI fact-check pass (spec section 28, layer 5) on each draft.
AI_FACT_CHECK_ENABLED=true

# --- Localization / feed (Phase 5) ---
# Max stories per feed (20 international + 20 local, spec section 21).
FEED_LIMIT=20
# Recency half-life for ranking, in hours (importance dominates).
RANK_RECENCY_HALF_LIFE_HOURS=18
# Multiplier applied to a country's own coverage in the local feed.
LOCAL_RELEVANCE_BONUS=1.10
# GeoIP backend: null | static | maxmind. Never blocks a visitor on failure.
GEOIP_PROVIDER=null
GEOIP_DATABASE_PATH=

# --- Cost controls ---
AI_MAX_REQUESTS_PER_HOUR=500
AI_MAX_TOKENS_PER_ARTICLE=4000
